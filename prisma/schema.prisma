generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  organizations OrganizationMember[]
  tasks         Task[]
  callMeBot     CallMeBot?
}

model CallMeBot {
  id        String   @id @default(cuid())
  phone     String
  apiKey    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  companies   Company[]
  contacts    Contact[]
  pipelines   Pipeline[]
  deals       Deal[]
  tasks       Task[]
  campaigns   EmailCampaign[]
  forms       Form[]
  projects    Project[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model OrganizationMember {
  id             String       @id @default(cuid())
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())

  userId         String
  organizationId String

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Project {
  id             String       @id @default(cuid())
  name           String
  description    String?      @db.Text
  icon           String?      // Stores an icon name (e.g., 'Folder', 'Target', 'Star') or emoji
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  forms          Form[]
  campaigns      EmailCampaign[]
  contacts       Contact[]
  companies      Company[]      @relation("ProjectCompanies")
  tasks          Task[]

  // Client company this project belongs to
  companyId      String?
  clientCompany  Company?       @relation("ProjectClientCompany", fields: [companyId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([companyId])
}

model Company {
  id             String       @id @default(cuid())
  name           String
  website        String?
  industry       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Custom SMTP settings for this company
  smtpHost       String?
  smtpPort       Int?
  smtpUser       String?
  smtpPass       String?
  smtpFromEmail  String?
  smtpSecure     Boolean?      @default(true)

  contacts       Contact[]
  deals          Deal[]
  campaigns      EmailCampaign[]
  forms          Form[]

  projectId      String?
  project        Project?     @relation("ProjectCompanies", fields: [projectId], references: [id], onDelete: SetNull)

  // Projects that belong to this client company
  clientProjects Project[]    @relation("ProjectClientCompany")

  @@index([organizationId])
  @@index([projectId])
}

model Contact {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  deals          Deal[]
  tasks          Task[]
  emailLogs      EmailLog[]

  source         String?      // E.g., "Manual", "Form: Contact Us"

  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([companyId])
  @@index([projectId])
}

model Pipeline {
  id             String       @id @default(cuid())
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stages         Stage[]

  @@index([organizationId])
}

model Stage {
  id             String       @id @default(cuid())
  name           String
  order          Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  pipelineId     String
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  deals          Deal[]

  @@index([pipelineId])
}

model Deal {
  id             String       @id @default(cuid())
  title          String
  value          Float?       @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stageId        String
  stage          Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)

  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  tasks          Task[]

  @@index([organizationId])
  @@index([stageId])
  @@index([companyId])
  @@index([contactId])
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?      @db.Text
  dueDate        DateTime?
  isCompleted    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedToId   String
  assignedTo     User         @relation(fields: [assignedToId], references: [id], onDelete: Cascade)

  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([assignedToId])
  @@index([dealId])
  @@index([contactId])
  @@index([projectId])
}

enum CampaignStatus {
  DRAFT
  SENDING
  COMPLETED
}

model EmailCampaign {
  id             String       @id @default(cuid())
  subject        String
  body           String       @db.LongText
  status         CampaignStatus @default(DRAFT)
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  formsAsWelcome Form[]       @relation("WelcomeEmail")

  logs           EmailLog[]

  @@index([organizationId])
  @@index([companyId])
  @@index([projectId])
}

enum EmailLogStatus {
  PENDING
  SENT
  FAILED
  OPENED
}

model EmailLog {
  id             String         @id @default(cuid())
  status         EmailLogStatus @default(PENDING)
  errorReason    String?        @db.Text
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  campaignId     String
  campaign       EmailCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  contactId      String
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([contactId])
}

model Form {
  id             String      @id @default(cuid())
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name           String
  description    String?     @db.Text
  isActive       Boolean     @default(true)
  
  successAction  String      @default("MESSAGE") // "MESSAGE" or "REDIRECT"
  successMessage String?     @db.Text
  redirectUrl    String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  welcomeEmailId String?
  welcomeEmail   EmailCampaign? @relation("WelcomeEmail", fields: [welcomeEmailId], references: [id], onDelete: SetNull)

  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  fields         FormField[]

  @@index([organizationId])
  @@index([companyId])
  @@index([projectId])
  @@index([welcomeEmailId])
}

model FormField {
  id          String   @id @default(cuid())
  
  formId      String
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  
  type        String   // TEXT, EMAIL, PHONE, NUMBER, TEXTAREA, SELECT, CHECKBOX, RADIO, DATE
  label       String
  name        String   // Internal name e.g., 'firstName'
  placeholder String?
  isRequired  Boolean  @default(false)
  options     String?  @db.Text // JSON string array for select/radio options
  order       Int

  @@index([formId])
}

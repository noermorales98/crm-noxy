generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String               @id @default(cuid())
  name          String?
  email         String               @unique
  passwordHash  String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  organizations OrganizationMember[]
  tasks         Task[]
  callMeBot     CallMeBot?
  activityLogs  ActivityLog[]
  aiConversations AiConversation[]
}

model CallMeBot {
  id                String   @id @default(cuid())
  phone             String
  apiKey            String
  notificationEmail String? // Email where form-submission alerts are sent
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("America/Cancun")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members               OrganizationMember[]
  companies             Company[]
  contacts              Contact[]
  emails                Email[]
  pipelines             Pipeline[]
  deals                 Deal[]
  activityLogs          ActivityLog[]
  proposals             Proposal[]
  payments              Payment[]
  tasks                 Task[]
  campaigns             EmailCampaign[]
  forms                 Form[]
  projects              Project[]
  availabilitySchedules AvailabilitySchedule[]
  blockedTimes          BlockedTime[]
  extendedAvailability  ExtendedAvailability[]
  appointmentTypes      AppointmentType[]
  appointments          Appointment[]
  taskCategories        TaskCategory[]
  clients               Client[]
  clientPayments        ClientPayment[]
  clientVaultEntries    ClientVaultEntry[]
  notifications         Notification[]
  googleCalendar        GoogleCalendarToken?
  kbPages               KbPage[]
  aiConversations       AiConversation[]
  hiddenAiModels        String         @default("[]")
  customAiModels        CustomAiModel[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model OrganizationMember {
  id        String   @id @default(cuid())
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  userId         String
  organizationId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  icon        String? // Stores an icon name (e.g., 'Folder', 'Target', 'Star') or emoji
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  forms     Form[]
  campaigns EmailCampaign[]
  contacts  Contact[]
  companies Company[]       @relation("ProjectCompanies")
  tasks     Task[]

  // Client company this project belongs to
  companyId     String?
  clientCompany Company? @relation("ProjectClientCompany", fields: [companyId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([companyId])
}

model Company {
  id        String   @id @default(cuid())
  name      String
  website   String?
  industry  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Custom SMTP settings for this company
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPass      String?
  smtpFromEmail String?
  smtpSecure    Boolean? @default(true)

  // Custom IMAP settings for receiving emails
  imapHost      String?
  imapPort      Int?
  imapUser      String?
  imapPass      String?
  imapSecure    Boolean? @default(true)
  imapLastUid   Int?     @default(0)

  contacts       Contact[]
  deals          Deal[]
  campaigns      EmailCampaign[]
  forms          Form[]
  taskCategories TaskCategory[]
  tasks          Task[]
  clients        Client[]

  projectId String?
  project   Project? @relation("ProjectCompanies", fields: [projectId], references: [id], onDelete: SetNull)

  // Projects that belong to this client company
  clientProjects Project[] @relation("ProjectClientCompany")

  emails           Email[]
  appointmentTypes AppointmentType[]

  @@index([organizationId])
  @@index([projectId])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  deals        Deal[]
  tasks        Task[]
  emailLogs    EmailLog[]
  appointments Appointment[]
  clients      Client[]

  source String? // E.g., "Manual", "Form: Contact Us"

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  sourceFormId String?
  sourceForm   Form?   @relation("FormContacts", fields: [sourceFormId], references: [id], onDelete: SetNull)

  sourceVariantId String?
  sourceVariant   FormVariant? @relation("VariantContacts", fields: [sourceVariantId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([companyId])
  @@index([projectId])
  @@index([sourceFormId])
  @@index([sourceVariantId])
}

model FormVariant {
  id          String   @id @default(cuid())
  formId      String
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts Contact[] @relation("VariantContacts")

  @@index([formId])
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stages Stage[]
  deals  Deal[]

  @@index([organizationId])
}

enum LeadSource {
  WHATSAPP
  REFERIDO
  LINKEDIN
  VISITA
  EMAIL_FRIO
  FORMULARIO
  INSTAGRAM
  OTRO
}

enum ActivityType {
  LLAMADA
  WHATSAPP
  VISITA
  EMAIL
  NOTA
  PROPUESTA_ENVIADA
  REUNION
  OTRO
}

enum ProposalStatus {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
}

enum PaymentType {
  ANTICIPO
  SALDO
  COMPLETO
  MENSUALIDAD
}

enum PaymentStatus {
  PENDIENTE
  RECIBIDO
  CANCELADO
}

model Stage {
  id        String   @id @default(cuid())
  name      String
  order     Int
  color     String   @default("#6B7280")
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  deals Deal[]

  @@index([pipelineId])
}

model Deal {
  id          String      @id @default(cuid())
  title       String
  value       Float?      @default(0)
  currency    String      @default("USD")
  source      LeadSource?
  followUpAt  DateTime?
  lostReason  String?
  probability Int         @default(50)
  notes       String?     @db.Text
  bookingToken String?    @unique @default(cuid())
  allowedBookingTypes String? @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  tasks       Task[]
  activities  ActivityLog[]
  proposals   Proposal[]
  payments    Payment[]
  appointments Appointment[]

  @@index([organizationId])
  @@index([stageId])
  @@index([pipelineId])
  @@index([companyId])
  @@index([contactId])
}

model ActivityLog {
  id          String       @id @default(cuid())
  type        ActivityType
  description String       @db.Text
  createdAt   DateTime     @default(now())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([organizationId])
  @@index([createdById])
}

model Proposal {
  id         String         @id @default(cuid())
  title      String
  status     ProposalStatus @default(BORRADOR)
  notes      String?        @db.Text
  validUntil DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  items ProposalItem[]

  @@index([dealId])
  @@index([organizationId])
}

model ProposalItem {
  id          String @id @default(cuid())
  description String
  quantity    Float  @default(1)
  unitPrice   Float
  order       Int    @default(0)

  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model Payment {
  id                   String        @id @default(cuid())
  amount               Float
  currency             String        @default("USD")
  type                 PaymentType
  status               PaymentStatus @default(PENDIENTE)
  method               String?
  notes                String?       @db.Text
  dueDate              DateTime?
  receivedAt           DateTime?
  stripePaymentLinkId  String?
  stripePaymentLinkUrl String?
  createdAt            DateTime      @default(now())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([organizationId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  categoryId String?
  category   TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  formId String?
  form   Form?   @relation(fields: [formId], references: [id], onDelete: SetNull)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([assignedToId])
  @@index([dealId])
  @@index([contactId])
  @@index([projectId])
  @@index([categoryId])
  @@index([companyId])
  @@index([formId])
  @@index([appointmentId])
}

enum CampaignStatus {
  DRAFT
  SENDING
  COMPLETED
}

model EmailCampaign {
  id        String         @id @default(cuid())
  subject   String
  body      String         @db.LongText
  status    CampaignStatus @default(DRAFT)
  sentAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  targetFormId String?
  targetForm   Form?   @relation("FormTargetCampaigns", fields: [targetFormId], references: [id], onDelete: SetNull)

  formsAsWelcome Form[] @relation("WelcomeEmail")

  logs EmailLog[]

  @@index([organizationId])
  @@index([companyId])
  @@index([projectId])
  @@index([targetFormId])
}

enum EmailLogStatus {
  PENDING
  SENT
  FAILED
  OPENED
}

model EmailLog {
  id          String         @id @default(cuid())
  status      EmailLogStatus @default(PENDING)
  errorReason String?        @db.Text
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([contactId])
}

model Form {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  isActive    Boolean @default(true)

  successAction  String  @default("MESSAGE") // "MESSAGE" or "REDIRECT"
  successMessage String? @db.Text
  redirectUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  welcomeEmailId String?
  welcomeEmail   EmailCampaign? @relation("WelcomeEmail", fields: [welcomeEmailId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  appointmentTypeId String?
  appointmentType   AppointmentType? @relation("FormAppointmentType", fields: [appointmentTypeId], references: [id], onDelete: SetNull)

  fields            FormField[]
  tasks             Task[]
  contacts          Contact[]       @relation("FormContacts")
  targetedCampaigns EmailCampaign[] @relation("FormTargetCampaigns")
  variants          FormVariant[]

  @@index([organizationId])
  @@index([companyId])
  @@index([projectId])
  @@index([welcomeEmailId])
  @@index([appointmentTypeId])
}

model FormField {
  id String @id @default(cuid())

  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  type        String // TEXT, EMAIL, PHONE, NUMBER, TEXTAREA, SELECT, CHECKBOX, RADIO, DATE
  label       String
  name        String // Internal name e.g., 'firstName'
  placeholder String?
  isRequired  Boolean @default(false)
  options     String? @db.Text // JSON string array for select/radio options
  order       Int

  @@index([formId])
}

model AvailabilitySchedule {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  timezone         String             @default("America/Mexico_City")
  isDefault        Boolean            @default(false)
  slots            AvailabilitySlot[]
  appointmentTypes AppointmentType[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([organizationId])
}

model BlockedTime {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String?
  start          DateTime
  end            DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model ExtendedAvailability {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String?
  date           DateTime
  startTime      String       // "10:00"
  endTime        String       // "14:00"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model AvailabilitySlot {
  id          String               @id @default(cuid())
  scheduleId  String
  schedule    AvailabilitySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime   String // "09:00"
  endTime     String // "17:00"
  isAvailable Boolean              @default(true)

  @@index([scheduleId])
}

model AppointmentType {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduleId     String
  schedule       AvailabilitySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name           String
  description    String?              @db.Text
  duration       Int // minutes
  color          String               @default("#3B82F6")
  location       String?
  slug           String
  isActive       Boolean              @default(true)
  bufferAfter    Int                  @default(0)
  maxAdvanceDays Int                  @default(30)
  appointments   Appointment[]
  forms          Form[]               @relation("FormAppointmentType")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([companyId])
}

model Appointment {
  id                String          @id @default(cuid())
  appointmentTypeId String
  appointmentType   AppointmentType @relation(fields: [appointmentTypeId], references: [id], onDelete: Cascade)
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId         String?
  contact           Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId            String?
  deal              Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  startTime         DateTime
  endTime           DateTime
  timezone          String          @default("America/Mexico_City")
  status            String          @default("CONFIRMED")
  guestName         String
  guestEmail        String
  guestPhone        String?
  notes             String?         @db.Text
  cancelToken       String?         @unique
  googleEventId     String?
  reminderSent1h    Boolean         @default(false)
  reminderSent10m   Boolean         @default(false)
  reminderSent5m    Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tasks             Task[]

  @@index([appointmentTypeId])
  @@index([organizationId])
  @@index([contactId])
  @@index([dealId])
  @@index([startTime])
}

model TaskCategory {
  id    String  @id @default(cuid())
  name  String
  color String? @default("#3B82F6")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([companyId])
}

enum EmailType {
  RECEIVED
  SENT
}

model Email {
  id          String    @id @default(cuid())
  messageId   String?   @db.VarChar(500) // Message-ID header for deduplication
  uid         Int?      // IMAP UID for incremental sync
  subject     String    @db.Text
  fromAddress String
  fromName    String?
  toAddress   String    @db.Text
  ccAddress   String?   @db.Text
  bodyText    String?   @db.LongText
  bodyHtml    String?   @db.LongText
  type        EmailType @default(RECEIVED)
  isRead      Boolean   @default(false)
  isArchived  Boolean   @default(false)
  receivedAt  DateTime  @default(now())
  scheduledAt DateTime? // null = not scheduled; future date = send at this time
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([organizationId])
  @@index([type])
  @@index([isArchived])
  @@index([scheduledAt])
}

model Client {
  id           String   @id @default(cuid())
  name         String
  monthlyFee   Float
  currency     String   @default("USD")
  startDate    DateTime
  billingDay   Int      @default(1)
  autoMarkPaid Boolean  @default(false)
  notes        String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Datos de contacto directos
  contactName  String?
  phone        String?
  phoneCode    String?  @default("+52")
  email        String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  payments     ClientPayment[]
  vaultEntries ClientVaultEntry[]

  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
}

model ClientVaultEntry {
  id        String   @id @default(cuid())
  type      String   @default("credential") // "credential" | "social" | "note"
  label     String
  username  String?
  password  String?  @db.Text
  url       String?  @db.Text
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId       String
  client         Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([organizationId])
}

model ClientPayment {
  id         String        @id @default(cuid())
  amount     Float
  currency   String        @default("USD")
  status     PaymentStatus @default(PENDIENTE)
  month      Int
  year       Int
  notes      String?       @db.Text
  dueDate    DateTime?
  receivedAt DateTime?
  createdAt  DateTime      @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([organizationId])
}

enum NotificationType {
  NEW_EMAIL
  NEW_CONTACT
  NEW_FORM_LEAD
  APPOINTMENT_REMINDER
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String?          @db.Text
  link      String?
  isRead    Boolean          @default(false)
  entityId  String?
  createdAt DateTime         @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([isRead])
  @@index([createdAt])
}

model GoogleCalendarToken {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accessToken    String       @db.Text
  refreshToken   String?      @db.Text
  expiresAt      DateTime?
  calendarId     String       @default("primary")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// ─── Knowledge Base ───────────────────────────────────────────────────────────

enum KbRelationType {
  PROJECT
  FORM
  CLIENT
  COMPANY
  APPOINTMENT_TYPE
  CONTACT
  DEAL
}

enum KbShareRole {
  READER
  EDITOR
  COMMENTATOR
}

enum KbSuggestionType {
  COMMENT
  REPLACE
  DELETE
  INSERT
}

enum KbSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model KbPage {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String           @default("Sin título")
  emoji          String?
  iconColor      String?
  iconBg         String?
  content        String?          @db.LongText
  parentId       String?
  parent         KbPage?          @relation("KbChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children       KbPage[]         @relation("KbChildren")
  isFolder       Boolean          @default(false)
  isPublished    Boolean          @default(false)
  markdownTheme  String           @default("minimal")
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  relations      KbPageRelation[]
  share          KbShare?
  suggestions    KbSuggestion[]

  @@index([organizationId])
  @@index([parentId])
  @@index([updatedAt])
}

model KbShare {
  id              String      @id @default(cuid())
  organizationId  String
  pageId          String      @unique
  page            KbPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  token           String      @unique @default(cuid())
  role            KbShareRole @default(READER)
  isEnabled       Boolean     @default(true)
  includeChildren Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([organizationId])
  @@index([token])
}

model KbSuggestion {
  id             String             @id @default(cuid())
  organizationId String
  pageId         String
  page           KbPage             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  authorName     String
  authorEmail    String?
  type           KbSuggestionType
  startOffset    Int?
  endOffset      Int?
  selectedText   String?            @db.Text
  suggestedText  String?            @db.Text
  comment        String?            @db.Text
  status         KbSuggestionStatus @default(PENDING)
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime           @default(now())

  @@index([pageId])
  @@index([organizationId])
  @@index([status])
}

model KbPageRelation {
  id          String         @id @default(cuid())
  pageId      String
  page        KbPage         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  entityType  KbRelationType
  entityId    String
  entityLabel String
  createdAt   DateTime       @default(now())

  @@unique([pageId, entityType, entityId])
  @@index([pageId])
}

model AiConversation {
  id             String       @id @default(cuid())
  title          String       @default("Nueva conversación")
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       AiMessage[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([updatedAt])
}

model AiMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String          @db.Text
  createdAt      DateTime        @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model CustomAiModel {
  id             String   @id @default(cuid())
  organizationId String
  modelId        String
  name           String
  group          String   @default("Personalizados")
  description    String   @default("")
  tags           String   @default("[]")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, modelId])
  @@index([organizationId])
}

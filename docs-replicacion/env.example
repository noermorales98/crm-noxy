# Variables de entorno — plantilla para crm-noxy
# Copiar a .env.local en la raíz y rellenar. Los scripts db:* cargan .env.local.

# ---------- Requeridas ----------
# Conexión MySQL/MariaDB para Prisma
DATABASE_URL="mysql://usuario:password@localhost:3306/mi_crm"

# Secreto NextAuth (JWT) + firma HMAC de tokens OAuth del MCP
# Generar: openssl rand -base64 32
AUTH_SECRET=""

# Bearer token que protege /api/cron/* en producción
CRON_SECRET=""

# URL pública canónica (links de cotizaciones, booking, emails)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ---------- SMTP global (fallback al SMTP por empresa en BD) ----------
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM_EMAIL=""

# ---------- Stripe (fallback a claves por organización en QuoteSettings) ----------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# ---------- IA (asistente, drafts, ideas, digest) ----------
# OPENROUTER_API_KEY=""
# OPENROUTER_API_KEY_SECONDARY=""
# CHATBASE_API_KEY=""
# CHATBASE_BOT_ID=""

# ---------- Google Calendar (OAuth) ----------
